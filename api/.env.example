# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Pon FORCE_IPV4_DNS=1 solo si tu red local no resuelve los SRV de Atlas.
# En Fly.io/producción déjalo sin valor o en 0.
FORCE_IPV4_DNS=0

# Dominios desde los que el frontend puede llamar a la API, separados por coma.
# En dev el frontend de Vite corre en localhost:5173.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Cadena de conexión completa de MongoDB Atlas, incluida la contraseña.
MONGO_URI=

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Secreto aleatorio para firmar sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# URL pública donde atiende la API. En producción, el dominio real.
BETTER_AUTH_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# OAuth
# ---------------------------------------------------------------------------
# Google Cloud Console -> Credenciales -> ID de cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
